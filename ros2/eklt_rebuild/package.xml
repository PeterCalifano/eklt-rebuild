<?xml version="1.0"?>
<package format="3">
  <name>eklt_rebuild</name>
  <version>0.1.0</version>
  <description>ROS2 EventPacket reconstruction and event-only tracking for eklt-rebuild.</description>
  <maintainer email="petercalifano.gs@gmail.com">Pietro Califano</maintainer>
  <maintainer email="daniel.gehrig18@gmail.com">Daniel Gehrig</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>event_camera_msgs</depend>
  <depend>event_camera_codecs</depend>
  <depend>opencv</depend>
  <depend>ceres-solver</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
