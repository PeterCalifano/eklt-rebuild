[build-system]
requires = ["setuptools>=61", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "@EKLT_PACKAGE_NAME@"
version = "@PROJECT_VERSION@"
description = "Generated Python bindings for EKLT reconstruction."
requires-python = ">=@EKLT_PYTHON_MIN_VERSION@"
license = {text = "GPL-3.0-only"}
authors = [
  {name = "Pietro Califano"},
  {name = "Daniel Gehrig"}
]
dependencies = ["numpy>=1.24"]

[project.optional-dependencies]
test = ["pytest>=7"]

[tool.setuptools]
packages = ["@PROJECT_NAME@"]
include-package-data = true

[tool.setuptools.package-data]
"@PROJECT_NAME@" = ["*.so", "*.so.*", "*.pyd", "*.dll", "*.dylib", "*.pyi", "**/*.pyi"]
