# Resolve the dependencies and feature surface exported by eklt-rebuild.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenCV 4 COMPONENTS core imgproc features2d)

set(@LIB_NAMESPACE@_WITH_CERES @EKLT_CONFIG_WITH_CERES@)
set(@LIB_NAMESPACE@_WITH_FIBAR ON)
set(@LIB_NAMESPACE@_WITH_ADAPTERS ON)
set(@LIB_NAMESPACE@_WITH_WRAPPER @EKLT_CONFIG_WITH_WRAPPER@)

if(@LIB_NAMESPACE@_WITH_CERES)
    find_dependency(Ceres)
endif()

find_dependency(fibar_lib)
find_dependency(Eigen3 3.4)

include("${CMAKE_CURRENT_LIST_DIR}/@EKLT_PACKAGE_NAME@Targets.cmake")

# Preserve logical API targets without publishing additional binaries.
foreach(_eklt_api_target IN ITEMS
        event_recon_fibar_core
        event_recon_fibar_adapters)
    set(_eklt_qualified_target
        "@LIB_NAMESPACE@::${_eklt_api_target}")
    if(TARGET "${_eklt_qualified_target}")
        continue()
    endif()

    add_library("${_eklt_qualified_target}" INTERFACE IMPORTED)
    set_property(
        TARGET "${_eklt_qualified_target}"
        PROPERTY INTERFACE_LINK_LIBRARIES
            @LIB_NAMESPACE@::@LIB_TARGET_NAME@
    )
endforeach()
unset(_eklt_api_target)
unset(_eklt_qualified_target)

check_required_components(@EKLT_PACKAGE_NAME@)
