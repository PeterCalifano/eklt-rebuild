{
  "topics": {
    "events": "/eklt/events",
    "image": "/eklt/image_raw",
    "rendered_frame": "/eklt/rendered_frame",
    "event_preview": "/eklt/event_preview",
    "feature_tracks": "/feature_tracks",
    "ros1_events": "/dvs/events",
    "ros1_image": "/dvs/image_raw"
  },
  "runtime": {
    "realtime_factor": 1.0,
    "publish_first_frame": true,
    "loop_forever": false
  },
  "frame": {
    "width": 640,
    "height": 480,
    "normalize_min": 0.0,
    "normalize_max": 1.0
  },
  "events": {
    "threshold_on_log": 0.2,
    "threshold_off_log": 0.2,
    "log_epsilon": 1e-6,
    "max_events_per_pixel_per_step": 8,
    "substeps_per_frame": 4,
    "substep_dt_us": 1000
  },
  "sequence": {
    "frames_dir": "/absolute/path/to/frames",
    "glob": "*.png",
    "fps": 20.0,
    "start_time_ns": 0
  }
}
