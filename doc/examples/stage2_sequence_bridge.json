{
  "topics": {
    "events": "/eklt/events",
    "image": "/eklt/image_raw",
    "rendered_frame": "/eklt/rendered_frame",
    "event_preview": "/eklt/event_preview",
    "feature_tracks": "/feature_tracks",
    "ros1_events": "/dvs/events",
    "ros1_image": "/dvs/image_raw"
  },
  "runtime": {
    "realtime_factor": 1.0,
    "publish_first_frame": true,
    "loop_forever": false
  },
  "frame": {
    "width": 640,
    "height": 480,
    "normalize_min": 0.0,
    "normalize_max": 1.0
  },
  "source": {
    "kind": "v2e_sequence"
  },
  "v2e": {
    "pos_thres": 0.2,
    "neg_thres": 0.2,
    "sigma_thres": 0.03,
    "cutoff_hz": 0.0,
    "leak_rate_hz": 0.1,
    "refractory_period_s": 0.0,
    "shot_noise_rate_hz": 0.0,
    "photoreceptor_noise": false,
    "leak_jitter_fraction": 0.1,
    "noise_rate_cov_decades": 0.1,
    "seed": 0,
    "device": "cpu"
  },
  "sequence": {
    "frames_dir": "/absolute/path/to/frames",
    "glob": "*.png",
    "fps": 20.0,
    "start_time_ns": 0
  }
}
